{
  // One Linux container that runs the whole stack with its own Docker engine
  // (Docker-in-Docker). Nothing runs on the host besides the devcontainer.
  "name": "litellm-hindsight-memory",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      // Install Docker CE instead of Moby; Moby packages are not available for this base image.
      "moby": false
    }
  },
  // Hindsight's full image is ~9 GB and loads local embedding and reranker models.
  "hostRequirements": {"cpus": 4, "memory": "8gb", "storage": "32gb"},
  "runArgs": ["--shm-size=1g"],
  "forwardPorts": [4000, 8888, 9999],
  "portsAttributes": {
    "4000": {"label": "LiteLLM proxy"},
    "8888": {"label": "Hindsight API"},
    "9999": {"label": "Hindsight UI"}
  },
  "containerEnv": {
    "LITELLM_URL": "http://localhost:4000",
    "HINDSIGHT_API_URL": "http://localhost:8888"
  },
  "postCreateCommand": "pip install -e '.[dev]' && (test -f .env || cp .env.example .env)",
  "customizations": {
    "vscode": {"extensions": ["ms-python.python", "charliermarsh.ruff"]}
  }
}
