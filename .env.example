# Pick ONE way for the local proxy to reach models.

# Option A: forward to an existing LiteLLM proxy (for example your company's),
# authenticated with your SSO token. No provider keys needed.
# Refresh an expired token with: scripts/stack.sh token <new-token>
LITELLM_CONFIG=litellm.upstream.yaml
UPSTREAM_LITELLM_URL=https://litellm.example.com
UPSTREAM_LITELLM_KEY=
# A model your upstream proxy offers, used by Hindsight to extract facts.
# List them with: scripts/stack.sh models
HINDSIGHT_LLM_MODEL=

# Option B: call providers directly with your own keys.
# LITELLM_CONFIG=litellm.yaml
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Local-only key for this proxy. Clients inside the devcontainer use it.
LITELLM_MASTER_KEY=sk-local-dev

# Reranking is most of recall's time on CPU (about 4 s for 100 candidates in the
# devcontainer, against under 200 ms without it). Options, fastest first:
#   - seed with --no-rerank to switch reranking off per bank,
#   - HINDSIGHT_RERANKER_PROVIDER=flashrank (small ONNX models built for CPU),
#   - fewer candidates with the default local cross-encoder.
# In production, use a GPU or a hosted reranker (see Hindsight's model docs).
HINDSIGHT_RERANKER_PROVIDER=local
HINDSIGHT_RERANKER_MAX_CANDIDATES=100
